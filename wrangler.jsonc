{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akramwii",
  "main": "worker.js",
  "compatibility_date": "2026-09-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": ["nodejs_compat"]
}