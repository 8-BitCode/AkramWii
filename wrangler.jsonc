{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akramwii",
  "main": "worker.js",
  "compatibility_date": "2026-09-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": true
  },
  // Cloudflare's built-in email sending. No destination_address is set here
  // so your inbox stays out of the repo; it comes from the CONTACT_TO secret
  // and must be a verified destination in Email Routing.
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
